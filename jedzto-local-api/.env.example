# ============================================================
# JedzTo Local API — zmienne środowiskowe
# ============================================================
# Skopiuj ten plik do .env i uzupełnij wartości.
# NIGDY nie commituj .env do repozytorium!
#
# Przed przejściem na produkcję:
#   1. Zamień klucze testowe Stripe na live (sk_live_... / pk_live_...)
#   2. Zamień token Mapbox na produkcyjny
#   3. Wygeneruj silny JWT_SECRET (np. `openssl rand -hex 64`)
#   4. Ustaw NODE_ENV=production
# ============================================================

# ------ Serwer --------------------------------------------
PORT=8001
NODE_ENV=development

# ------ MongoDB -------------------------------------------
# Lokalnie: zostaw puste (połączy się z localhost:27017/jedzto lub użyje pamięci)
# Produkcja: np. mongodb+srv://user:pass@cluster.mongodb.net/jedzto
MONGODB_URI=

# ------ JWT -----------------------------------------------
# WYMAGANE na produkcji. Wygeneruj: openssl rand -hex 64
# Lokalnie aplikacja wyświetli ostrzeżenie przy użyciu wartości domyślnej.
JWT_SECRET=

# ------ Stripe --------------------------------------------
# Klucze testowe — działają bezpiecznie, nie pobierają prawdziwych pieniędzy.
# Zamień na klucze LIVE (sk_live_ / pk_live_) przed wdrożeniem produkcyjnym.
#
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_TEST_OR_LIVE_KEY
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_OR_LIVE_KEY

# ------ Mapbox --------------------------------------------
# Klucz testowy/developerski — zamień na produkcyjny token przed wdrożeniem.
# Dashboard: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=REPLACE_WITH_YOUR_MAPBOX_TOKEN

# ------ CORS / Publiczne URL ------------------------------
# Rozdzielone przecinkami originy, które mogą odpytywać API.
# Lokalnie: zostaw puste (akceptuje localhost:*).
# Produkcja: https://admin.jedzto.pl,https://app.jedzto.pl
ALLOWED_ORIGINS=

# Publiczny URL API (używany w linkach do obrazków i Stripe redirect).
# Lokalnie: zostaw puste (używa localhost:PORT).
# Tunel ngrok: https://abc123.ngrok.io
PUBLIC_API_URL=

# ------ Seeding -------------------------------------------
# Ustaw na 0, żeby wyłączyć automatyczne seedowanie przy starcie.
SEED_ON_START=1

# ------ Tryb otwarty (dev) --------------------------------
# 1 = API akceptuje zapytania bez tokenu BOP (upraszcza dev)
# 0 = wymaga tokenu publicznego (bezpieczniejsze)
LOCAL_API_OPEN=1
