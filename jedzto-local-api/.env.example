# ============================================================
# JedzTo Local API — zmienne środowiskowe
# ============================================================
# Skopiuj ten plik do .env i uzupełnij wartości.
# NIGDY nie commituj .env do repozytorium!
#
# Przed przejściem na produkcję:
#   1. Zamień klucze testowe Stripe na live (sk_live_... / pk_live_...)
#   2. Zamień token Mapbox na produkcyjny
#   3. Wygeneruj silny JWT_SECRET (np. `openssl rand -hex 64`)
#   4. Ustaw NODE_ENV=production
# ============================================================

# ------ Serwer --------------------------------------------
PORT=8001
NODE_ENV=development

# ------ MongoDB -------------------------------------------
# Prefer real MongoDB when available:
#   MONGODB_URI=mongodb://127.0.0.1:27017/jedzto
#   Produkcja (MongoDB Atlas, free M0): mongodb+srv://user:pass@cluster.mongodb.net/jedzto
#
# Jeśli lokalne Mongo nie działa, API używa trwałej bazy na dysku
# (.data/mongodb) — restauracje i zamówienia NIE znikają po restarcie.
# Na produkcji USTAW ALLOW_MEMORY_MONGO=0 — bez tego, jeśli Atlas jest
# nieosiągalny, API po cichu spadnie na (efemeryczny) lokalny fallback.
MONGODB_URI=mongodb://127.0.0.1:27017/jedzto
ALLOW_MEMORY_MONGO=1
# MONGO_MEMORY_DB_PATH=.data/mongodb

# ------ JWT -----------------------------------------------
# WYMAGANE na produkcji. Wygeneruj: openssl rand -hex 64
# Lokalnie aplikacja wyświetli ostrzeżenie przy użyciu wartości domyślnej.
JWT_SECRET=

# ------ Stripe --------------------------------------------
# Klucze testowe — działają bezpiecznie, nie pobierają prawdziwych pieniędzy.
# Zamień na klucze LIVE (sk_live_ / pk_live_) przed wdrożeniem produkcyjnym.
#
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_TEST_OR_LIVE_KEY
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_OR_LIVE_KEY

# WYMAGANE na produkcji (API nie wystartuje bez tego, jeśli Stripe jest włączony).
# Sekret podpisu webhooka (whsec_...) — bez niego nie da się bezpiecznie
# potwierdzić płatności. Endpoint: POST <PUBLIC_API_URL>/stripe/webhook
# Lokalnie: stripe listen --forward-to localhost:8001/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ------ Mapbox --------------------------------------------
# Klucz testowy/developerski — zamień na produkcyjny token przed wdrożeniem.
# Dashboard: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=REPLACE_WITH_YOUR_MAPBOX_TOKEN

# ------ CORS / Publiczne URL ------------------------------
# Rozdzielone przecinkami originy, które mogą odpytywać API.
# Lokalnie: zostaw puste (akceptuje localhost:*).
# Produkcja: https://admin.jedzto.pl,https://app.jedzto.pl
ALLOWED_ORIGINS=

# Publiczny URL API (używany w linkach do obrazków i Stripe redirect).
# Lokalnie: zostaw puste (używa localhost:PORT).
# Tunel ngrok: https://abc123.ngrok.io
PUBLIC_API_URL=

# ------ Seeding -------------------------------------------
# Ustaw na 0, żeby wyłączyć automatyczne seedowanie przy starcie.
SEED_ON_START=1

# ------ Tryb otwarty (dev) --------------------------------
# 1 = API akceptuje zapytania bez tokenu BOP (upraszcza dev)
# 0 = wymaga tokenu publicznego (bezpieczniejsze)
# Uwaga: w NODE_ENV=production ta flaga jest ignorowana (zawsze wyłączona).
LOCAL_API_OPEN=1

# ------ OTP / SMSAPI.pl -----------------------------------
# 1 = akceptuj deweloperski kod 123456 (tylko dev; w produkcji zawsze wyłączone)
ALLOW_TEST_OTP=1
# Token OAuth / API z panelu SMSAPI (Bearer). Gdy ustawiony, OTP idzie SMS-em.
SMSAPI_TOKEN=
# Zweryfikowane pole nadawcy z panelu SMSAPI
SMSAPI_FROM=Test
# 1 = tryb testowy SMSAPI (bez realnej wysyłki)
SMSAPI_TEST=0
# Opcjonalnie wymuś bramkę: 1=włącz, 0=wyłącz (domyślnie = czy jest SMSAPI_TOKEN)
# SMS_GATEWAY_ENABLED=1

# ------ Logowanie społecznościowe -------------------------
# Identyfikatory klienta OAuth Google (pole `aud` tokenu ID), rozdzielone
# przecinkami. Wymagane, aby token Google nie mógł pochodzić z innej aplikacji.
GOOGLE_CLIENT_IDS=

# ------ Reguły cenowe -------------------------------------
# Ryczałt za dostawę, gdy restauracja nie ma zdefiniowanych obszarów.
DELIVERY_RATE=9.99
# Dopłata za płatność gotówką przy odbiorze (COD).
COD_CASH_FEE=2

# ------ Cloudinary (trwałe zdjęcia) ------------------------
# WYMAGANE w praktyce na produkcji: Render/Fly/Cloud Run mają dysk efemeryczny
# — bez Cloudinary każde zdjęcie dodane przez panel/restauratora zniknie przy
# najbliższym redeployu. Darmowe konto: https://cloudinary.com/users/register/free
# Dashboard → Cloud name / API Key / API Secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
