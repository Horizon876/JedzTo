{
  "name": "jedzto",
  "private": true,
  "description": "JedzTo — local orchestration for API + apps",
  "scripts": {
    "api": "npm --prefix jedzto-local-api start",
    "api:dev": "npm --prefix jedzto-local-api run dev",
    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo-lan.ps1 -Target app",
    "kitchen": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-expo-lan.ps1 -Target kitchen",
    "fix:metro": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/fix-metro-cache.ps1",
    "admin": "npm --prefix enatega-multivendor-admin run dev",
    "install:api": "npm --prefix jedzto-local-api install",
    "install:app": "npm --prefix enatega-multivendor-app install",
    "install:kitchen": "npm --prefix enatega-multivendor-rider install"
  }
}
