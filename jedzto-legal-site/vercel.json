{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/polityka-prywatności", "destination": "/polityka-prywatnosci" },
    { "source": "/polityka-prywatnosci/", "destination": "/polityka-prywatnosci" },
    { "source": "/regulamin/", "destination": "/regulamin" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
